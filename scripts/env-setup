#!/usr/bin/env bash

# Set stop on error / enable debug
set -euo pipefail

############################################################################
# ENVSETUP
############################################################################

##{{{#######################################################################
############################################################################
# FUNCTIONS
############################################################################

# Config env-setup
config() {
    ENVSETUP_CONFIG_MSG="Select an env-setup config (enter q to quit):"
    CONFIG=${1:-""}
    CFILE="$INSTALL_DIR/config.yml"
    CONFIG_TYPE=""

    # Check -L before -f: `-f` follows the link, so a dangling symlink would
    # fall through and be misreported as "default".
    if [[ -L "$CFILE" ]]; then
        CONFIG_TYPE="$(basename "$(readlink "$CFILE")")"
        CONFIG_TYPE="${CONFIG_TYPE#.}"
        CONFIG_TYPE="${CONFIG_TYPE%.config.yml}"
    elif [[ -f "$CFILE" ]]; then
        CONFIG_TYPE="custom"
    else
        CONFIG_TYPE="default"
    fi

    echo -e "${C_SUC}Config currently set to ${C_WAR}$CONFIG_TYPE${C_RES}"
    echo -e "${C_SUC}$ENVSETUP_CONFIG_MSG${C_RES}\n"
    if [[ -z "$CONFIG" && "$ENVSETUP_INTERACT" == "1" ]]; then
        OPTIONS="none mini default most custom"
        select CONFIG in $OPTIONS; do
            break
        done
    fi

    if [[ -z "$CONFIG" ]]; then
        echo -e "${C_WAR}Quit${C_RES}\n"
        exit 0
    fi

    # Validate BEFORE touching anything on disk. config.yml is gitignored and
    # may be the user's only copy, so an unknown name must be a no-op rather
    # than an rm followed by a dangling symlink.
    if ! config_is_valid "$CONFIG" "none mini default most custom"; then
        echo -e "${C_ERR}Unknown config '${CONFIG}'${C_RES}"
        echo -e "${C_WAR}Valid configs: none mini default most custom${C_RES}\n"
        exit 1
    fi

    if [[ "$CONFIG" == "custom" ]]; then
        echo -e "${C_SUC}Select starter for custom config:${C_RES}\n"
        OPTIONS="none mini default most"
        STARTER=""
        select STARTER in $OPTIONS; do
            break
        done
        if [[ -z "$STARTER" ]]; then
            echo -e "${C_WAR}Quit${C_RES}\n"
            exit 0
        fi
        config_rm "$CFILE"
        cp "$(config_src "$STARTER")" "$CFILE"
        echo -e "${C_SUC}Starter custom config set${C_RES}"
    else
        config_rm "$CFILE"
        if [[ "$CONFIG" != "default" ]]; then
            ln -s "$(config_src "$CONFIG")" "$CFILE"
        fi
        echo -e "${C_SUC}Config set to ${C_WAR}$CONFIG${C_RES}"
    fi
}

# Is $1 one of the whitespace-separated names in $2?
config_is_valid() {
    local needle="$1" name
    for name in $2; do
        [[ "$needle" == "$name" ]] && return 0
    done
    return 1
}

# Remove an existing config.yml, including a dangling symlink.
# `-f` follows links, so it is false for a dangling one -- which would leave
# the stale link in place and make the subsequent `ln -s` fail.
config_rm() {
    [[ -e "$1" || -L "$1" ]] && rm "$1"
    return 0
}

# Resolve a preset name to its source file.
# Falls back to the undotted name because the Homebrew formula does not
# install .default.config.yml, which would otherwise break `-c custom`.
config_src() {
    local dotted="$INSTALL_DIR/.$1.config.yml"
    local plain="$INSTALL_DIR/$1.config.yml"
    if [[ -e "$dotted" ]]; then
        printf '%s\n' "$dotted"
    else
        printf '%s\n' "$plain"
    fi
}

# Update env-setup
update() {
    cd "$INSTALL_DIR"

    if [[ -f config.yml ]]; then
        ANSIBLE_EXTRA_VARS="-e @config.yml"
    else
        ANSIBLE_EXTRA_VARS="-e @default.config.yml"
    fi

    # Local name: do NOT reassign ENVSETUP_DIR, which the shared library owns.
    REPO_DIR=$(pwd)
    # shellcheck disable=SC2086
    PUB_DOTFILES_DIR=$(ansible -m shell                                    \
        -a "echo {{ pub_dotfiles_repo_local_destination }}" -t tmp         \
        localhost $ANSIBLE_EXTRA_VARS 2> /dev/null | cut -d'>' -f3 | xargs \
        || true)
    # shellcheck disable=SC2086
    PRV_DOTFILES_DIR=$(ansible -m shell                                    \
        -a "echo {{ prv_dotfiles_repo_local_destination }}" -t tmp         \
        localhost $ANSIBLE_EXTRA_VARS 2> /dev/null | cut -d'>' -f3 | xargs \
        || true)
    # Guarded: the ansible calls above tolerate failure, in which case this
    # file was never created and an unguarded rm would abort under `set -e`.
    [[ -f "tmp/localhost" ]] && rm "tmp/localhost"

    while read -r DOTFILE_PATH; do
        DOTFILE_PATH="${DOTFILE_PATH/'~'/$HOME}"
        # An unresolved dotfiles var yields an empty line; skip it rather
        # than cd-ing to an empty path.
        [[ -n "$DOTFILE_PATH" && -d "$DOTFILE_PATH" ]] || continue
        REPO="$(basename "$DOTFILE_PATH")"
        echo -e "\n${C_HIL}Updating $REPO...${C_RES}"
        cd "$DOTFILE_PATH"

        GIT_STASH="env-setup-update-$(date +%s)"
        git stash -m "$GIT_STASH"
        git pull --rebase
        # shellcheck disable=SC1083
        git stash apply stash^{/"$GIT_STASH"} 2> /dev/null || true
        git stash drop 0 2> /dev/null || true
    done < <(echo -e "$REPO_DIR\n$PUB_DOTFILES_DIR\n$PRV_DOTFILES_DIR")
}

# Run env-setup playbook
run_playbook() {
    PLAYBOOK_NAME=${1:-""}
    PLAYBOOK_DIR=${2:-""}

    if [[ -d "$PLAYBOOK_DIR" ]]; then
        if [[ -z "$ANSIBLE_PLAYBOOK_INFO" ]]; then
            echo -e "\n${C_HIL}Run $PLAYBOOK_NAME playbook...${C_RES}"
        else
            echo -e "\n${C_HIL}Show $PLAYBOOK_NAME playbook tasks...${C_RES}"
        fi
        # NOT "PWD" -- that is bash's magic variable; assigning to it breaks
        # the restoring cd below and so breaks `env-setup all` after the
        # first playbook.
        PREV_DIR=$(pwd)
        cd "$PLAYBOOK_DIR"

        if [[ -f requirements.yml ]]; then
            # shellcheck disable=SC2086
            ansible-galaxy install $ANSIBLE_VERBOSE -r requirements.yml
        fi
        if [[ "$ANSIBLE_SUDO" == "-K" ]]; then
            echo -e "\n${C_WAR}Enter password for install permissions${C_RES}"
        else
            ANSIBLE_SUDO=""
        fi
        if [[ -f ../../../config.yml ]]; then
            ANSIBLE_EXTRA_VARS="-e @../../../config.yml"
        else
            ANSIBLE_EXTRA_VARS=""
        fi

        ANSIBLE_TAG_FLAGS=""
        if [[ -n "$ANSIBLE_SKIPPED_TAGS" ]]; then
            ANSIBLE_TAG_FLAGS="--skip-tags $ANSIBLE_SKIPPED_TAGS"
        fi
        if [[ -n "$ANSIBLE_TAGS" ]]; then
            ANSIBLE_TAG_FLAGS="${ANSIBLE_TAG_FLAGS:+$ANSIBLE_TAG_FLAGS }--tags $ANSIBLE_TAGS"
        fi

        # shellcheck disable=SC2086
        ansible-playbook main.yml $ANSIBLE_VERBOSE $ANSIBLE_CHECK \
            $ANSIBLE_TAG_FLAGS                                    \
            -i inventory $ANSIBLE_SUDO                            \
            $ANSIBLE_EXTRA_VARS                                   \
            $ANSIBLE_PLAYBOOK_INFO
        cd "$PREV_DIR"
        echo -e "\n${C_SUC}$PLAYBOOK_NAME playbook completed!${C_RES}"
    else
        echo -e "\n${C_ERR}Could not find the $PLAYBOOK_NAME playbook!${C_RES}"
        exit 1
    fi
}

##}}}#######################################################################


#/ Usage: $SCRIPT [PLAYBOOK]
#/
#/
#/   <PLAYBOOK>: An optional playbook name for env-setup to run.
#/
#/ Examples:
#/
#/   $SCRIPT
#/      Start $SCRIPT to select playbooks to setup.
#/   $SCRIPT -A
#/      Generate aliases to be sourced with "eval "$(env-setup -A)
#/   $SCRIPT vm <subcommand>
#/      Run a vm subcommand (create, start, stop, status, ssh, scp, env-setup, init)
#/   $SCRIPT -c
#/      Set a new config.
#/   $SCRIPT -C 02-cli
#/      Run "02-cli" playbook as a "dry-run". (--check)
#/   $SCRIPT -i 04-packages
#/      Show "04-packages" playbook tasks.
#/   $SCRIPT -e
#/      Open the custom config.yml for editing via $EDITOR
#/   $SCRIPT -s prv_dotfiles 01-config
#/      Run "01-config" playbook with skipping the prv_dotfiles tasks
#/   $SCRIPT -t pub_dotfiles 01-config
#/      Run "01-config" playbook with only the pub_dotfiles tasks
#/   $SCRIPT -v 03-apps
#/      Run "03-apps" playbook in verbose mode.
#/   $SCRIPT 04-my-playbook
#/      Have $SCRIPT run the "04-my-playbook" playbook.
#/
#/ Subcommands:
#/   vm <subcommand>: Tart VM management (create, start, stop, status, ssh, scp, env-setup, init)
#/
#/ Options:
#/   --help/-h: Display this help message
#/          -A: Generate aliases for env-setup tools
#/          -c: Set a new config
#/          -C: Check the changes of the playbook.
#/          -i: Get task info about a playbook.
#/          -e: Open custom config.yml w/ $EDITOR
#/          -s: Run playbook with SKIPPED tags
#/          -t: Run playbook with tags
#/          -u: Update env-setup from its remote Git source
#/          -v: Run env-setup with verbose mode
SCRIPT=$(basename "${BASH_SOURCE[0]}")
SCRIPTS_DIR="$(dirname "${BASH_SOURCE[0]}")"
# shellcheck source=scripts/_common
source "$SCRIPTS_DIR/_common"

usage() {
    grep '^#/' "${BASH_SOURCE[0]}" | cut -c4- | sed -e "s/\$SCRIPT/$SCRIPT/g" ; exit 0 ;
}

vm_usage() {
    cat << EOF
Usage: $SCRIPT vm <subcommand> [args...]

Subcommands:
  create [macos|linux|all]     Create Tart VMs
  start <vm-name>              Start a Tart VM
  stop <vm-name>               Stop a Tart VM
  status [vm-name]             Show status of Tart VMs
  ssh [vm-name] [cmd...]       SSH to a Tart VM
  scp [vm-name] <src> <dst>    SCP to/from a Tart VM
  env-setup [vm-name] [args]   Run env-setup inside a Tart VM
  init [vm-name] <url>         Run bootstrap init script inside a Tart VM
  warm [vm-name]               Pre-install common packages and galaxy reqs in VM
  test [macos|linux] [target]  Run ephemeral E2E tests with idempotency assertion
EOF
}

parse_flags() {
    expr "$*" : ".*--help" > /dev/null && usage

    OPTIND=1
    while getopts 'AcCheis:t:uv' FLAG; do
        # shellcheck disable=SC2317
        case "${FLAG}" in
            A)
                echo "alias env-vm-create=\"$INSTALL_DIR/scripts/vm/create\""
                echo "alias env-vm-env-setup=\"$INSTALL_DIR/scripts/vm/env-setup\""
                echo "alias env-vm-init=\"$INSTALL_DIR/scripts/vm/init\""
                echo "alias env-vm-scp=\"$INSTALL_DIR/scripts/vm/scp\""
                echo "alias env-vm-ssh=\"$INSTALL_DIR/scripts/vm/ssh\""
                echo "alias env-vm-start=\"$INSTALL_DIR/scripts/vm/start\""
                echo "alias env-vm-stop=\"$INSTALL_DIR/scripts/vm/stop\""
                echo "alias env-vm-warm=\"$INSTALL_DIR/scripts/vm/warm\""
                echo "alias env-vm-test=\"$INSTALL_DIR/scripts/vm/test\""
                echo "Warning: env-vm-* aliases are deprecated; use 'env-setup vm <subcommand>' instead." >&2
                exit 0
                ;;
            c) shift "$((OPTIND-1))"; config "${1:-""}"; exit 0 ;;
            C) ANSIBLE_CHECK="-C" ;;
            h) usage ;;
            e)
                if [[ -z "${EDITOR:-}" ]]; then
                    echo -e "${C_ERR}\$EDITOR is not set${C_RES}"
                    echo -e "${C_WAR}e.g. EDITOR=vim $SCRIPT -e${C_RES}"
                    exit 1
                fi
                "$EDITOR" "$INSTALL_DIR/config.yml"
                echo -e "${C_SUC}Updated ${C_WAR}$INSTALL_DIR/config.yml${C_RES}"
                exit 0
                ;;
            i) ANSIBLE_PLAYBOOK_INFO="--list-tasks" ;;
            s) ANSIBLE_SKIPPED_TAGS="$OPTARG" ;;
            t) ANSIBLE_TAGS="$OPTARG" ;;
            u) update; exit 0 ;;
            v)
                set -vx
                ANSIBLE_VERBOSE="-vvv"
                ANSIBLE_STDOUT_CALLBACK="debug"
                ;;
            *) : ;;
        esac
    done
    shift "$((OPTIND-1))"
    PLAYBOOK="${1:-""}"
    if [[ $# -gt 1 ]]; then
        EXTRA_ARGS=("${@:2}")
    else
        EXTRA_ARGS=()
    fi
}

main() {
    parse_flags "$@"

    if [[ "$PLAYBOOK" == "vm" ]]; then
        local vm_cmd="${EXTRA_ARGS[0]:-""}"
        if [[ -z "$vm_cmd" || "$vm_cmd" == "-h" || "$vm_cmd" == "--help" ]]; then
            vm_usage
            exit 0
        fi
        local vm_script="$SCRIPTS_DIR/vm/$vm_cmd"
        if [[ -x "$vm_script" ]]; then
            exec "$vm_script" "${EXTRA_ARGS[@]:1}"
        else
            echo -e "${C_ERR}Unknown vm subcommand: $vm_cmd${C_RES}\n" >&2
            vm_usage >&2
            exit 1
        fi
    fi

    ANSIBLE_SUDO=${ANSIBLE_SUDO-"-K"}
    ANSIBLE_CHECK=${ANSIBLE_CHECK:-""}
    ANSIBLE_PLAYBOOK_INFO=${ANSIBLE_PLAYBOOK_INFO:-""}
    ANSIBLE_SKIPPED_TAGS=${ANSIBLE_SKIPPED_TAGS:-""}
    ANSIBLE_TAGS=${ANSIBLE_TAGS:-""}
    ANSIBLE_VERBOSE=${ANSIBLE_VERBOSE:-""}
    # unixy | dense | debug | yaml | selective
    export ANSIBLE_STDOUT_CALLBACK=${ANSIBLE_STDOUT_CALLBACK:-"unixy"}
    export ANSIBLE_ROLES_PATH="$HOME/.ansible/roles"
    ENVSETUP_SELECT_MSG="Select an env-setup playbook (enter q to quit):"
    INIT_PLAYBOOK=".00-init"

    if [[ "$ENVSETUP_OS" == darwin* ]] && command -v python3 > /dev/null 2>&1; then
        PY_VER=$(python3 -m site --user-site 2> /dev/null | cut -d'/' -f6 || true)
        if [[ -n "$PY_VER" && ":$PATH:" != *":$HOME/Library/Python/$PY_VER/bin:"* ]]; then
            PATH="$PATH:$HOME/Library/Python/$PY_VER/bin"
        fi
    fi
    if [[ ":$PATH:" != *":/usr/local/bin:"* ]]; then
        export PATH="$PATH:/usr/local/bin"
    fi

    SUGGEST_ANSIBLE=$(if [[ -x "$(command -v ansible)" ]]; then \
        echo "0"; else echo "${ENVSETUP_SUGGEST_ANSIBLE:-1}"; fi)
    if [[ $SUGGEST_ANSIBLE == "1" ]]; then
        echo -e "To begin we'll need to...\n"
        if [[ $ENVSETUP_OS =~ "darwin"* ]]; then
            SUGGEST_PIP=$(if [[ "$(python3 -m pip -V 2> /dev/null)" ]]; then \
                echo "0"; else echo "${ENVSETUP_SUGGEST_PIP:-1}"; fi)
            if [[ $SUGGEST_PIP == "1" ]]; then
                echo -e "[ ] install Pip"
            fi
        fi
        echo -e "[ ] install Ansible"
        if [[ $ENVSETUP_INTERACT == "1" ]]; then
            read -r -p "Continue? (yes/no): " ANSWER
            [[ $ANSWER == "yes" ]] || exit 0
            echo -e "\n"
        fi
    fi

    case "$ENVSETUP_OS" in
        darwin*)
            if [[ $SUGGEST_ANSIBLE == "1" ]]; then
                "$SCRIPTS_DIR/macos/install-ansible"
            fi
            ABSOLUTE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" \
                && pwd)/$(basename "${BASH_SOURCE[0]}")"
            PLAYBOOKS="${ENVSETUP_PLAYBOOKS_DIR:-"$(dirname "$(dirname "$ABSOLUTE_PATH")")/ansible/macos"}"
            ;;
        linux*)
            if [[ $SUGGEST_ANSIBLE == "1" ]]; then
                "$SCRIPTS_DIR/linux/install-ansible"
            fi
            PLAYBOOKS="${ENVSETUP_PLAYBOOKS_DIR:-"$(dirname "$(realpath "$SCRIPTS_DIR")")/ansible/linux"}"
            ;;
        *)
            echo -e "${C_WAR}Unsupported OS${C_RES}\n"
            exit 1
            ;;
    esac

    if [[ ! -f "$PLAYBOOKS/$INIT_PLAYBOOK/.init" ]]; then
        run_playbook "Initial" "$PLAYBOOKS/$INIT_PLAYBOOK"
    fi

    if [[ -z "$PLAYBOOK" ]]; then
        echo -e "${C_SUC}$ENVSETUP_SELECT_MSG${C_RES}\n"
        # shellcheck disable=SC2116,SC2046
        OPTIONS=$(find "$PLAYBOOKS/"* -type d -print0 | xargs -0 -n1 basename)
        select PLAYBOOK in $OPTIONS; do
            if [[ "$PLAYBOOK" == "" ]]; then
                echo -e "${C_WAR}Quit${C_RES}\n"
                exit 0
            else
                run_playbook "$PLAYBOOK" "$PLAYBOOKS/$PLAYBOOK"
                echo -e "\n${C_SUC}$PLAYBOOK completed!${C_RES}"
                exit 0
            fi
        done
        echo -e "${C_SUC}$ENVSETUP_SELECT_MSG${C_RES}\n"
    else
        if [[ "$PLAYBOOK" == "all" ]]; then
            echo -e "${C_SUC}Running all playbooks:${C_RES}\n"
            OPTIONS=$(find "$PLAYBOOKS/"* -type d -print0 | xargs -0 -n1 basename)
            for PLAYBOOK in $OPTIONS; do
                run_playbook "$PLAYBOOK" "$PLAYBOOKS/$PLAYBOOK"
            done
        else
            run_playbook "$PLAYBOOK" "$PLAYBOOKS/$PLAYBOOK"
        fi
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
