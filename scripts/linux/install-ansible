#!/usr/bin/env bash

# Set stop on error / enable debug
set -euo pipefail
#set -vx

############################################################################
# LINUX INSTALL ANSIBLE
############################################################################

SCRIPTS_DIR="$(dirname "$0")"
# shellcheck source=scripts/_common
source "$SCRIPTS_DIR/../_common"

############################################################################
# MAIN
############################################################################

echo -e "${C_HIL}Installing Ansible...${C_RES}"

if [ -x "$(command -v apk)" ]; then
    sudo apk add ansible
elif [ -x "$(command -v apt-get)" ]; then
    OS_RELEASE_FILE="${OS_RELEASE_FILE:-/etc/os-release}"
    DISTRO_ID=""
    if [[ -f "$OS_RELEASE_FILE" ]]; then
        # shellcheck disable=SC1090
        DISTRO_ID=$(. "$OS_RELEASE_FILE" && printf '%s' "${ID:-}")
    fi
    if [[ "$DISTRO_ID" == "ubuntu" ]]; then
        sudo apt update --yes
        sudo apt install --yes software-properties-common
        sudo add-apt-repository --yes --update ppa:ansible/ansible
        sudo apt install --yes ansible
    else
        sudo apt-get update --yes
        sudo apt-get install --yes ansible python3-apt
    fi
elif [ -x "$(command -v dnf)" ]; then
    sudo dnf install -y ansible
elif [ -x "$(command -v zypper)" ]; then
    sudo zypper --non-interactive in ansible
else
    echo -e "${C_WAR}No Package Manager${C_RES}\n"
    exit 1
fi
