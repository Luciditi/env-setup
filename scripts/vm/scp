#!/usr/bin/env bash
set -euo pipefail

SCRIPTS_DIR="$(dirname "${BASH_SOURCE[0]}")"
# shellcheck source=scripts/_common
source "$SCRIPTS_DIR/../_common"
# shellcheck source=scripts/_vm
source "$SCRIPTS_DIR/../_vm"
# shellcheck source=scripts/_remote
source "$SCRIPTS_DIR/../_remote"

TARGET_VM=""
if [[ $# -ge 3 ]]; then
    TARGET_VM="$1"
    SRC_FILE="$2"
    DST_PATH="$3"
elif [[ $# -eq 2 ]]; then
    SRC_FILE="$1"
    DST_PATH="$2"
    TARGET_VM=$(vm_find_running)
else
    echo -e "usage: scp [vm-name] <SRC_FILE> <DST_PATH>" >&2
    exit 1
fi

if [[ -z "$SRC_FILE" || ! -e "$SRC_FILE" || -z "$DST_PATH" ]]; then
    echo -e "\n${C_ERR}Source file does not exist or destination is empty!${C_RES}" >&2
    echo -e "usage: scp [vm-name] <SRC_FILE> <DST_PATH>" >&2
    exit 1
fi

if [[ -z "$TARGET_VM" ]]; then
    echo -e "\n${C_ERR}No running test VM found!${C_RES}" >&2
    exit 1
fi

if ! vm_running "$TARGET_VM"; then
    echo -e "\n${C_ERR}VM $TARGET_VM is not running!${C_RES}" >&2
    exit 1
fi

SSH_HOST=$(vm_ip "$TARGET_VM")
echo -e "\n${C_HIL}Copying $SRC_FILE to $TARGET_VM ($SSH_HOST:$DST_PATH)${C_RES}"
remote_copy "$SRC_FILE" "$SSH_HOST" "$DST_PATH"
