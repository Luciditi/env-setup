#!/usr/bin/env bash
set -euo pipefail

SCRIPTS_DIR="$(dirname "${BASH_SOURCE[0]}")"
# shellcheck source=scripts/_common
source "$SCRIPTS_DIR/../_common"
# shellcheck source=scripts/_vm
source "$SCRIPTS_DIR/../_vm"
# shellcheck source=scripts/_remote
source "$SCRIPTS_DIR/../_remote"

TARGET_VM=""
if [[ $# -gt 0 ]]; then
    if vm_running "$1" || vm_exists "$1"; then
        TARGET_VM="$1"
        shift
    fi
fi

if [[ -z "$TARGET_VM" ]]; then
    TARGET_VM=$(vm_find_running)
fi

if [[ -z "$TARGET_VM" ]]; then
    echo -e "\n${C_ERR}No running test VM found!${C_RES}" >&2
    echo -e "usage: warm [vm-name]" >&2
    exit 1
fi

if ! vm_running "$TARGET_VM"; then
    echo -e "\n${C_ERR}VM $TARGET_VM is not running!${C_RES}" >&2
    exit 1
fi

SSH_HOST=$(vm_ip "$TARGET_VM")
echo -e "\n${C_HIL}Warming VM environment on $TARGET_VM ($SSH_HOST)...${C_RES}"

FORMULAE=$("$SCRIPTS_DIR/../formula-intersection" --format=space)

REMOTE_CMD="set -euo pipefail
if command -v ansible-galaxy >/dev/null 2>&1; then
    echo 'Installing Ansible Galaxy requirements...'
    ansible-galaxy role install geerlingguy.dotfiles --force || true
    ansible-galaxy collection install community.general --force || true
fi
if command -v brew >/dev/null 2>&1; then
    echo 'Installing warm formulae...'
    brew install $FORMULAE || true
fi"

remote_exec "$SSH_HOST" "$REMOTE_CMD"
echo -e "\n${C_SUC}VM $TARGET_VM warmed successfully.${C_RES}"
